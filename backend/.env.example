PORT=3005
MONGO_URI="mongodb+srv://<user>:<password>@cluster.mongodb.net/course-selling-app"

JWT_SECRET_USER="a_long_random_secret_for_users"
JWT_SECRET_ADMIN="a_different_long_random_secret_for_admins"

# Email (Resend — https://resend.com)
# Get API key from: Resend Dashboard → API Keys → Create API Key
RESEND_API_KEY="re_your_resend_api_key_here"

#Frontend URL (for CORS — set to deployed URL in production)
FRONTEND_URL="http://localhost:5173"

# Razorpay 
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
# Webhook secret — set this after configuring your webhook in Razorpay Dashboard
# Dashboard → Settings → Webhooks → Add Webhook → copy the secret here
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# AWS S3 
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your_iam_access_key_id"
AWS_SECRET_ACCESS_KEY="your_iam_secret_access_key"
AWS_S3_BUCKET_NAME="your-s3-bucket-name"

# CloudFront (for signed streaming URLs) 
CLOUDFRONT_DOMAIN="d1234abcdef.cloudfront.net"
CLOUDFRONT_KEY_PAIR_ID="APKAXXXXXXXXXXX"
# Store private key as a single line — replace real newlines with \n
# e.g.  -----BEGIN RSA PRIVATE KEY-----\nMIIEo...\n-----END RSA PRIVATE KEY-----
CLOUDFRONT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"